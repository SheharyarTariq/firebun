# Copy to .env.local (never committed).

# --- Postgres (Supabase → Connect → Connection string) ---------------------------
# App runtime AND migrations: Session pooler, port 5432. Do not use the transaction
# pooler (6543): it stalls connections when postgres.js pipelines queries (see db/pool.ts).
DATABASE_URL="postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres"
# Optional: a different URL for drizzle-kit (defaults to DATABASE_URL).
DIRECT_URL="postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# --- Auth ----------------------------------------------------------------------
# Signs the session cookie. Generate with: openssl rand -base64 32
AUTH_SECRET=""
# Used once by `npm run db:seed` to create the first admin. Defaults: admin@gmail.com / Admin@123
SEED_ADMIN_EMAIL="admin@gmail.com"
SEED_ADMIN_PASSWORD="Admin@123"

# --- Supabase API (only needed later for Storage uploads) -----------------------
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
# Server-only. Must NOT be prefixed NEXT_PUBLIC_ or it ships to the browser.
SUPABASE_SECRET_KEY=""
